/* ===================================================
   Cartify - Light Theme (Premium Violet)
   =================================================== */

QWidget {
    background-color: #F8FAFC;
    color: #111827;
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow {
    background-color: #F8FAFC;
}

/* ---------------- Sidebar ---------------- */

#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

#SidebarTitle {
    color: #111827;
    font-size: 21px;
    font-weight: 800;
    padding: 6px 0 18px 0;
}

#SidebarDivider {
    background-color: #E5E7EB;
    max-height: 1px;
    margin: 0 22px 16px 22px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #6B7280;
    text-align: left;
    padding-left: 20px;
    border-radius: 12px;
    border-left: 4px solid transparent;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background-color: #F3F4F8;
    color: #111827;
}

QPushButton#NavButton:checked {
    background-color: #EEF2FF;
    color: #4F46E5;
    border-left: 4px solid #4F46E5;
    font-weight: 700;
}

QPushButton#NavButton:pressed {
    background-color: #E0E7FF;
}

/* ---------------- Navbar / Header ---------------- */

#Navbar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}

#NavbarTitle {
    color: #4F46E5;
    font-size: 30px;
    font-weight: 800;
}

#NavbarSubtitle {
    color: #64748B;
    font-size: 13px;
}

#NavbarAdmin {
    color: #1F2937;
    font-weight: 600;
}

#AdminAvatar {
    background-color: #4F46E5;
    color: #FFFFFF;
    border-radius: 18px;
    font-weight: 700;
    font-size: 15px;
}

#AdminAvatar:hover {
    background-color: #4338CA;
}

/* ---------------- Cards ---------------- */

#Card, #StatCard, #ChartCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}

#Card:hover, #StatCard:hover, #ChartCard:hover {
    border: 1px solid #D8DDF0;
}

#StatIconBadge {
    background-color: #EEF2FF;
    color: #4F46E5;
    border: 1px solid #C7D2FE;
    border-radius: 23px;
    font-size: 18px;
    font-weight: 800;
}

#StatValue {
    color: #111827;
    font-size: 31px;
    font-weight: 800;
}

#StatTitle {
    color: #64748B;
    font-size: 12px;
    font-weight: 700;
}

#TileValue {
    color: #111827;
    font-size: 25px;
    font-weight: 800;
}

#ChartTitle {
    color: #111827;
    font-size: 16px;
    font-weight: 800;
}

#PanelLabel {
    color: #64748B;
    font-size: 12px;
    font-weight: 700;
}

#MetricTile {
    background-color: #F8FAFC;
    border: 1px solid #EEF2F7;
    border-radius: 14px;
}

#DetailText {
    color: #1F2937;
    background-color: transparent;
}

#SettingsDivider {
    background-color: #EEF2F7;
    border: none;
}

#SettingsRow {
    background-color: transparent;
}

#SettingsItemTitle {
    color: #111827;
    font-size: 14px;
    font-weight: 800;
}

#SettingsItemDescription {
    color: #64748B;
    font-size: 12px;
}

#SettingsValuePill {
    background-color: #EEF2FF;
    color: #4F46E5;
    border: 1px solid #C7D2FE;
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 800;
}

/* ---------------- Buttons ---------------- */

QPushButton {
    min-height: 20px;
}

QPushButton#PrimaryButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 700;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #4338CA;
}

QPushButton#PrimaryButton:pressed {
    background-color: #3730A3;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #D1D5DB;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 700;
}

QPushButton#SecondaryButton:hover {
    background-color: #F3F4F6;
    border: 1px solid #C7D2FE;
    color: #4F46E5;
}

QPushButton#SecondaryButton:pressed {
    background-color: #E5E7EB;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#DangerButton {
    background-color: #DC2626;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 700;
    border: none;
}

QPushButton#DangerButton:hover {
    background-color: #B91C1C;
}

QPushButton#DangerButton:pressed {
    background-color: #991B1B;
    padding-top: 11px;
    padding-bottom: 9px;
}

QToolButton#SortButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 12px;
    padding: 7px;
}

QToolButton#SortButton:hover {
    background-color: #EEF2FF;
    border: 1px solid #818CF8;
}

QToolButton#SortButton:pressed {
    background-color: #E0E7FF;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
}

/* ---------------- Inputs ---------------- */

QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 10px;
    padding: 9px 12px;
    color: #111827;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover, QTextEdit:hover {
    border: 1px solid #A5B4FC;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #4F46E5;
    background-color: #FFFFFF;
}

/* Keep numeric form fields spacious so their values never sit beneath arrows. */
QDateEdit, QDoubleSpinBox, QSpinBox {
    min-height: 34px;
    padding: 0 42px 0 14px;
}

QDateEdit::drop-down,
QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 28px;
    background-color: #F8FAFC;
    border-left: 1px solid #D1D5DB;
}

QDoubleSpinBox::up-button, QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 9px;
}

QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 9px;
}

QDateEdit::drop-down {
    subcontrol-position: center right;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

QDateEdit::down-arrow {
    image: url(gui/assets/calendar_light.svg);
    width: 20px;
    height: 20px;
}

/* ---------------- Calendar Popup ---------------- */

QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #111827;
}

QCalendarWidget QToolButton {
    color: #312E81;
    background-color: #EEF2FF;
    border: 1px solid #C7D2FE;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 700;
}

QCalendarWidget QToolButton:hover {
    background-color: #E0E7FF;
    border-color: #818CF8;
}

QCalendarWidget QSpinBox {
    color: #111827;
    background-color: #FFFFFF;
    border: 1px solid #C7D2FE;
    border-radius: 7px;
    min-width: 92px;
    padding: 2px 28px 2px 8px;
    font-weight: 700;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #111827;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
    outline: 0;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #94A3B8;
}

QCalendarWidget QHeaderView::section {
    background-color: #EEF2FF;
    color: #312E81;
    border: none;
    padding: 6px;
    font-weight: 700;
}

/* Keep weekday names readable even after the global table-header rules. */
QCalendarWidget QTableView QHeaderView::section,
QCalendarWidget QHeaderView::section {
    background-color: #EEF2FF;
    color: #312E81;
    border: 1px solid #E0E7FF;
    padding: 6px;
    font-weight: 700;
}

#SearchBarContainer {
    background-color: transparent;
}

#SearchBar {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 20px;
    padding: 9px 18px;
}

QProgressBar {
    background-color: #E5E7EB;
    border: none;
    border-radius: 7px;
}

QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 7px;
}

/* ---------------- Table ---------------- */

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FBFCFE;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    gridline-color: #EEF2F7;
    selection-background-color: #EEF2FF;
    selection-color: #111827;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #334155;
    padding: 13px 12px;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    font-weight: 700;
}

QTableWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:hover {
    background-color: #F5F7FF;
    color: #111827;
}

QTableWidget::item:selected {
    background-color: #EEF2FF;
    color: #3730A3;
}

/* ---------------- Scrollbars ---------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4F46E5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4F46E5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------------- Misc ---------------- */

QLabel#PageTitle {
    color: #111827;
    font-size: 27px;
    font-weight: 800;
}

QLabel#PageSubtitle {
    color: #64748B;
    font-size: 14px;
}

QTextEdit {
    line-height: 145%;
}

QDialog {
    background-color: #F8FAFC;
}

QRadioButton {
    background-color: transparent;
    color: #374151;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:checked {
    background-color: #4F46E5;
    border: 2px solid #4F46E5;
    border-radius: 8px;
}

QRadioButton::indicator:unchecked {
    background-color: #FFFFFF;
    border: 2px solid #CBD5E1;
    border-radius: 8px;
}

QCheckBox#ToggleSwitch {
    background-color: transparent;
    spacing: 0;
}

QCheckBox#ToggleSwitch::indicator {
    width: 46px;
    height: 24px;
    border-radius: 12px;
}

QCheckBox#ToggleSwitch::indicator:unchecked {
    background-color: #CBD5E1;
    border: 1px solid #CBD5E1;
}

QCheckBox#ToggleSwitch::indicator:checked {
    background-color: #4F46E5;
    border: 1px solid #4F46E5;
}

QCheckBox#ToggleSwitch::indicator:unchecked:hover {
    background-color: #B6C2D3;
    border: 1px solid #B6C2D3;
}

QCheckBox#ToggleSwitch::indicator:checked:hover {
    background-color: #4338CA;
    border: 1px solid #4338CA;
}

QToolTip {
    background-color: #111827;
    color: #FFFFFF;
    border: none;
    padding: 6px;
    border-radius: 6px;
}

/* Final calendar-header override: protects weekday contrast from table styles. */
QCalendarWidget QTableView QHeaderView::section,
QCalendarWidget QHeaderView::section {
    background-color: #EEF2FF;
    color: #312E81;
    border: 1px solid #E0E7FF;
    padding: 6px;
    font-weight: 700;
}
