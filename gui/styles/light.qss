/* ===================================================================
   Cartify - Light theme
   Generated from one token-driven template so both themes share the
   exact same structure. Colours are tuned per theme.
   =================================================================== */

/* ---------------- Base ---------------- */

QWidget {
    color: #1C1A3A;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #EEF0FB;
}

QLabel {
    background: transparent;
}

QStackedWidget {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QToolTip {
    background-color: #1C1A3A;
    color: #FFFFFF;
    border: 1px solid #1C1A3A;
    padding: 6px 10px;
    border-radius: 8px;
}

/* ---------------- Canvas + Shell ---------------- */

#Canvas {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #D3D8F3, stop:1 #E9EBFA);
}

#Shell {
    background-color: #F7F8FE;
    border: 1px solid #FFFFFF;
    border-radius: 32px;
}

/* ---------------- Sidebar (floating violet pill) ---------------- */

#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.7, y2:1, stop:0 #7060D4, stop:1 #4C3DA4);
    border: 1px solid #8B7DE6;
    border-radius: 30px;
}

#SidebarScroll {
    background: transparent;
    border: none;
}

#SidebarNav {
    background: transparent;
}

#SidebarTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 800;
}

#SidebarCaption {
    color: rgba(255, 255, 255, 165);
    font-size: 11px;
}

#SidebarDivider {
    background-color: rgba(255, 255, 255, 38);
    max-height: 1px;
    border: none;
}

QPushButton#NavButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 195);
    text-align: left;
    padding-left: 16px;
    border: 1px solid transparent;
    border-radius: 17px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background-color: rgba(255, 255, 255, 32);
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: rgba(255, 255, 255, 58);
    border-color: rgba(255, 255, 255, 80);
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#NavButton:pressed {
    background-color: rgba(255, 255, 255, 76);
}

QPushButton#NavButton[collapsed="true"] {
    padding-left: 0px;
    text-align: center;
}

/* ---------------- Header ---------------- */

#Navbar {
    background: transparent;
}

#NavbarCrumb {
    color: #8B8EAB;
    font-size: 14px;
    font-weight: 600;
}

#NavbarTitle {
    color: #1C1A3A;
    font-size: 15px;
    font-weight: 800;
}

#NavbarSubtitle {
    color: #8B8EAB;
    font-size: 13px;
}

#NavbarUserChip {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF8;
    border-radius: 25px;
}

#NavbarAdmin {
    color: #1C1A3A;
    font-size: 13px;
    font-weight: 700;
}

#NavbarRole {
    color: #8B8EAB;
    font-size: 11px;
}

#AdminAvatar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7A6BDC, stop:1 #5848B8);
    color: #FFFFFF;
    border-radius: 18px;
    font-weight: 800;
    font-size: 14px;
}

QToolButton#ThemeToggle {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF8;
    border-radius: 22px;
    padding: 0px;
}

QToolButton#ThemeToggle:hover {
    background-color: #EFECFD;
    border-color: #DDD7F8;
}

/* ---------------- Cards ---------------- */

#Card, #ChartCard, #StatCard, #FilterBar {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF8;
    border-radius: 24px;
}

#FilterBar {
    border-radius: 22px;
}

#StatCard[clickable="true"]:hover {
    border-color: #CFC8F5;
    background-color: #FEFEFF;
}

#HeroCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7A6BDC, stop:0.55 #6D60C6, stop:1 #5848B8);
    border: 1px solid rgba(255, 255, 255, 70);
    border-radius: 30px;
}

#AccentCardViolet {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8171E9, stop:1 #5848B8);
    border: 1px solid rgba(255, 255, 255, 70);
    border-radius: 28px;
}

#AccentCardPink {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F58BB0, stop:1 #EA5C8D);
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 28px;
}

#AccentCardViolet[clickable="true"]:hover, #AccentCardPink[clickable="true"]:hover {
    border-color: rgba(255, 255, 255, 150);
}

#HeroTitle {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 700;
}

#HeroSub {
    color: rgba(255, 255, 255, 175);
    font-size: 12px;
}

#HeroGlass {
    background-color: rgba(255, 255, 255, 30);
    border: 1px solid rgba(255, 255, 255, 46);
    border-radius: 22px;
}

#HeroGlassStrong {
    background-color: rgba(255, 255, 255, 56);
    border: 1px solid rgba(255, 255, 255, 84);
    border-radius: 22px;
}

#HeroKpiValue {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 800;
}

#HeroKpiLabel {
    color: rgba(255, 255, 255, 185);
    font-size: 11px;
    font-weight: 600;
}

#AccentTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

#AccentSub {
    color: rgba(255, 255, 255, 195);
    font-size: 12px;
}

#AccentValue {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 800;
}

QPushButton#GlassButton {
    background-color: rgba(255, 255, 255, 52);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 84);
    border-radius: 17px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0px;
}

QPushButton#GlassButton:hover {
    background-color: rgba(255, 255, 255, 82);
}

#StatValue {
    color: #1C1A3A;
    font-size: 29px;
    font-weight: 800;
}

#StatTitle {
    color: #8B8EAB;
    font-size: 13px;
    font-weight: 600;
}

#StatCaption {
    color: #8B8EAB;
    font-size: 11px;
}

#StatShare {
    color: #27AE6B;
    font-size: 11px;
    font-weight: 700;
}

#StatLink {
    color: #5B4BC4;
    background-color: #EFECFD;
    border: 1px solid #DDD7F8;
    border-radius: 12px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 700;
}

#TileValue {
    color: #1C1A3A;
    font-size: 25px;
    font-weight: 800;
}

#ChartTitle {
    color: #1C1A3A;
    font-size: 16px;
    font-weight: 800;
}

#ChartSub {
    color: #8B8EAB;
    font-size: 12px;
}

#PanelLabel {
    color: #8B8EAB;
    font-size: 12px;
    font-weight: 600;
}

#PanelValue {
    color: #1C1A3A;
    font-size: 13px;
    font-weight: 800;
}

#MetricTile {
    background-color: #F4F5FC;
    border: 1px solid #ECEEF8;
    border-radius: 18px;
}

#ReportKpiCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE3F5;
    border-radius: 14px;
}

#ReportKpiLabel {
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
}

#ReportKpiValue {
    color: #4F46E5;
    font-size: 23px;
    font-weight: 800;
}

#DetailText {
    color: #1C1A3A;
    background-color: transparent;
}

#DetailSection {
    color: #1C1A3A;
    font-size: 15px;
    font-weight: 800;
}

#DetailValue {
    color: #1C1A3A;
    font-size: 14px;
    font-weight: 700;
}

#SettingsDivider {
    background-color: #F0F1F9;
    border: none;
}

#SettingsRow {
    background-color: transparent;
}

#SettingsItemTitle {
    color: #1C1A3A;
    font-size: 14px;
    font-weight: 700;
}

#SettingsItemDescription {
    color: #8B8EAB;
    font-size: 12px;
}

/* ---------------- Pills / badges ---------------- */

QLabel#Pill, QLabel#SettingsValuePill {
    background-color: #EFECFD;
    color: #5B4BC4;
    border: 1px solid #DDD7F8;
    border-radius: 13px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#Pill[tone="pink"] {
    background-color: #FDE7F0;
    color: #D8467E;
    border-color: #F9CFE0;
}

QLabel#Pill[tone="green"] {
    background-color: #E3F6EC;
    color: #1E8E57;
    border-color: #C4EBD6;
}

QLabel#Pill[tone="amber"] {
    background-color: #FFF1D9;
    color: #B97609;
    border-color: #FBE0B0;
}

/* ---------------- Buttons ---------------- */

QPushButton#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7A6BDC, stop:1 #5848B8);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 60);
    border-radius: 16px;
    padding: 10px 22px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8675F2, stop:1 #6452D1);
}

QPushButton#PrimaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6D60C6, stop:1 #4D3FA1);
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#PrimaryButton:disabled {
    background: #E9EAF6;
    color: #8B8EAB;
    border-color: #E9EAF6;
}

QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1C1A3A;
    border: 1px solid #E4E6F4;
    border-radius: 16px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#SecondaryButton:hover {
    background-color: #EFECFD;
    border-color: #DDD7F8;
    color: #5B4BC4;
}

QPushButton#SecondaryButton:pressed {
    background-color: #DDD7F8;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#SecondaryButton:disabled {
    background-color: #F4F5FC;
    color: #8B8EAB;
    border-color: #F0F1F9;
}

QPushButton#DangerButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E5484D, stop:1 #B2383C);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 50);
    border-radius: 16px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#DangerButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #F74D53, stop:1 #C33D42);
}

QPushButton#DangerButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #CE4045, stop:1 #972F33);
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#SendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7A6BDC, stop:1 #5848B8);
    border: 1px solid rgba(255, 255, 255, 60);
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
}

QPushButton#SendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8373ED, stop:1 #6250CE);
}

QPushButton#SendButton:disabled {
    background: #E9EAF6;
    border-color: #E9EAF6;
}

QToolButton#SortButton, QToolButton#IconButton {
    background-color: #FFFFFF;
    border: 1px solid #E4E6F4;
    border-radius: 16px;
    padding: 7px;
}

QToolButton#SortButton:hover, QToolButton#IconButton:hover {
    background-color: #EFECFD;
    border-color: #DDD7F8;
}

QToolButton#SortButton:pressed, QToolButton#IconButton:pressed {
    background-color: #DDD7F8;
}

QToolButton#SortButton::menu-indicator {
    image: none;
    width: 0px;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #CFC8F5;
    border-radius: 14px;
    padding: 7px;
}

QMenu::item {
    padding: 9px 30px 9px 14px;
    border-radius: 9px;
    color: #1C1A3A;
}

QMenu::item:selected {
    background-color: #EFECFD;
    color: #5B4BC4;
}

QMenu::separator {
    height: 1px;
    background: #F0F1F9;
    margin: 6px 8px;
}

/* ---------------- Inputs ---------------- */

QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: #F4F5FC;
    border: 1px solid #E4E6F4;
    border-radius: 15px;
    padding: 9px 14px;
    color: #1C1A3A;
    selection-background-color: #6C5CD6;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover, QTextEdit:hover {
    border-color: #C9C2F2;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border-color: #6C5CD6;
    background-color: #FFFFFF;
}

QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled {
    color: #8B8EAB;
    background-color: #F4F5FC;
    border-color: #F0F1F9;
}

QLineEdit#SearchBar {
    border-radius: 22px;
    padding: 9px 18px;
}

QComboBox {
    padding: 9px 38px 9px 14px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 34px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(@ASSETS@/chevron_down_light.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1C1A3A;
    border: 1px solid #CFC8F5;
    border-radius: 12px;
    padding: 6px;
    outline: 0;
    selection-background-color: #EFECFD;
    selection-color: #5B4BC4;
}

QDateEdit, QDoubleSpinBox, QSpinBox {
    padding: 7px 40px 7px 14px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 36px;
    border: none;
    background: transparent;
}

QDateEdit::down-arrow {
    image: url(@ASSETS@/calendar_light.svg);
    width: 18px;
    height: 18px;
}

QDoubleSpinBox::up-button, QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    background: transparent;
    margin: 4px 6px 0px 0px;
}

QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    border: none;
    background: transparent;
    margin: 0px 6px 4px 0px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #EFECFD;
    border-radius: 8px;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {
    image: url(@ASSETS@/chevron_up_light.svg);
    width: 10px;
    height: 10px;
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {
    image: url(@ASSETS@/chevron_down_light.svg);
    width: 10px;
    height: 10px;
}

/* ---------------- Calendar popup ---------------- */

QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #CFC8F5;
    border-radius: 14px;
}

QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #1C1A3A;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #EFECFD;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    padding: 4px;
}

QCalendarWidget QToolButton {
    color: #5B4BC4;
    background-color: transparent;
    border: none;
    border-radius: 9px;
    padding: 6px 10px;
    font-weight: 700;
}

QCalendarWidget QToolButton:hover {
    background-color: #DDD7F8;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(@ASSETS@/chevron_left_light.svg);
    icon-size: 16px;
    min-width: 28px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(@ASSETS@/chevron_right_light.svg);
    icon-size: 16px;
    min-width: 28px;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QCalendarWidget QSpinBox {
    color: #1C1A3A;
    background-color: #FFFFFF;
    border: 1px solid #DDD7F8;
    border-radius: 9px;
    min-width: 92px;
    padding: 2px 28px 2px 8px;
    font-weight: 700;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #1C1A3A;
    selection-background-color: #6C5CD6;
    selection-color: #FFFFFF;
    outline: 0;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #8B8EAB;
}

QCalendarWidget QTableView QHeaderView::section,
QCalendarWidget QHeaderView::section {
    background-color: #FFFFFF;
    color: #5B4BC4;
    border: none;
    padding: 6px;
    font-weight: 700;
}

#SearchBarContainer {
    background-color: transparent;
}

/* ---------------- Progress ---------------- */

QProgressBar {
    background-color: #E9EAF6;
    border: none;
    border-radius: 6px;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7A6BDC, stop:1 #5848B8);
    border-radius: 6px;
}

QProgressBar[tone="green"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3CC98A, stop:1 #1F9F66);
}

QProgressBar[tone="pink"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #F58BB0, stop:1 #EA5C8D);
}

QProgressBar[thin="true"] {
    min-height: 7px;
    max-height: 7px;
    border-radius: 4px;
}

QProgressBar[thin="true"]::chunk {
    border-radius: 4px;
}

/* ---------------- Tables ---------------- */

QTableWidget {
    background: transparent;
    border: none;
    outline: 0;
    gridline-color: transparent;
    selection-background-color: transparent;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: transparent;
    color: #8B8EAB;
    padding: 12px 14px;
    border: none;
    border-bottom: 1px solid #F0F1F9;
    font-weight: 700;
    font-size: 12px;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QTableWidget::item {
    padding: 0px 14px;
    border-bottom: 1px solid #F0F1F9;
    color: #1C1A3A;
}

QTableWidget::item:hover {
    background-color: #F6F5FF;
}

QTableWidget::item:selected {
    background-color: #EDE9FD;
    color: #4A3DA8;
}

#EmptyState {
    background: transparent;
}

#EmptyTitle {
    color: #1C1A3A;
    font-size: 16px;
    font-weight: 800;
}

#EmptyHint {
    color: #8B8EAB;
    font-size: 13px;
}

/* ---------------- Scrollbars ---------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: #D6D2F2;
    border-radius: 3px;
    min-height: 34px;
}

QScrollBar::handle:vertical:hover {
    background: #6C5CD6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #D6D2F2;
    border-radius: 3px;
    min-width: 34px;
}

QScrollBar::handle:horizontal:hover {
    background: #6C5CD6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---------------- Typography ---------------- */

QLabel#PageTitle {
    color: #1C1A3A;
    font-size: 26px;
    font-weight: 800;
}

QLabel#PageSubtitle {
    color: #8B8EAB;
    font-size: 14px;
}

QLabel#DialogTitle {
    color: #1C1A3A;
    font-size: 21px;
    font-weight: 800;
}

QLabel#DialogSubtitle {
    color: #8B8EAB;
    font-size: 13px;
}

QLabel#FilterLabel {
    color: #8B8EAB;
    font-size: 12px;
    font-weight: 700;
}

QDialog QLabel {
    color: #8B8EAB;
    font-weight: 600;
}

QTextEdit {
    line-height: 145%;
}

/* ---------------- Dialogs / message boxes ---------------- */

QMessageBox {
    background-color: #EEF0FB;
}

QMessageBox QLabel {
    color: #1C1A3A;
    font-size: 14px;
    font-weight: 500;
}

QMessageBox QPushButton {
    background-color: #FFFFFF;
    color: #1C1A3A;
    border: 1px solid #E4E6F4;
    border-radius: 14px;
    padding: 8px 22px;
    min-width: 72px;
    font-weight: 700;
}

QMessageBox QPushButton:hover {
    background-color: #EFECFD;
    border-color: #DDD7F8;
    color: #5B4BC4;
}

QMessageBox QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7A6BDC, stop:1 #5848B8);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 60);
}

QRadioButton {
    background-color: transparent;
    color: #1C1A3A;
    spacing: 10px;
    font-weight: 600;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #6C5CD6;
    border-color: #EFECFD;
}

QRadioButton::indicator:unchecked {
    background-color: #F4F5FC;
    border-color: #C9C2F2;
}

QCheckBox#ToggleSwitch {
    background-color: transparent;
    spacing: 0;
}

/* ---------------- AI assistant ---------------- */

#AIUserBubble {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7A6BDC, stop:1 #5848B8);
    border: 1px solid rgba(255, 255, 255, 60);
    border-radius: 22px;
}

#AIAssistantBubble {
    background-color: #F4F5FC;
    border: 1px solid #ECEEF8;
    border-radius: 22px;
}

#AIMessageRole {
    color: #5B4BC4;
    font-size: 12px;
    font-weight: 800;
}

#AIMessageRoleUser {
    color: rgba(255, 255, 255, 190);
    font-size: 12px;
    font-weight: 800;
}

#AIMessageText {
    color: #1C1A3A;
    font-size: 14px;
}

#AIMessageTextUser {
    color: #FFFFFF;
    font-size: 14px;
}

#AITyping {
    color: #5B4BC4;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
}

#AISectionLabel {
    color: #8B8EAB;
    font-size: 12px;
    font-weight: 800;
    margin-top: 4px;
}

#AIProductCard {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF8;
    border-radius: 18px;
}

#AIProductTitle {
    color: #1C1A3A;
    font-size: 14px;
    font-weight: 800;
}

#AIProductPrice {
    color: #5B4BC4;
    font-size: 16px;
    font-weight: 800;
}

#AIProductMeta {
    color: #8B8EAB;
    font-size: 12px;
}

QPushButton#AIChip {
    background-color: #F4F5FC;
    color: #5B4BC4;
    border: 1px solid #DDD7F8;
    border-radius: 16px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#AIChip:hover {
    background-color: #EFECFD;
    border-color: #6C5CD6;
}

QPushButton#AICopy {
    background-color: transparent;
    color: #8B8EAB;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#AICopy:hover {
    background-color: #EFECFD;
    color: #5B4BC4;
}

/* ---------------- Login / splash ---------------- */

#LoginRoot, #SplashRoot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #D3D8F3, stop:1 #E9EBFA);
}

#LoginShell {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF8;
    border-radius: 32px;
}

#LoginHero {
    background: qlineargradient(x1:0, y1:0, x2:0.8, y2:1, stop:0 #7060D4, stop:0.6 #5B4EAD, stop:1 #4C3DA4);
    border: 1px solid rgba(255, 255, 255, 70);
    border-radius: 26px;
}

#LoginHeroTitle {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 800;
}

#LoginHeroText {
    color: rgba(255, 255, 255, 195);
    font-size: 14px;
}

#LoginFeatureTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
}

#LoginFeatureText {
    color: rgba(255, 255, 255, 175);
    font-size: 11px;
}

#LoginTitle {
    color: #1C1A3A;
    font-size: 28px;
    font-weight: 800;
}

#LoginError {
    color: #E5484D;
    background-color: #FDE8E8;
    border: 1px solid #F9CACB;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

#SplashCard {
    background: qlineargradient(x1:0, y1:0, x2:0.8, y2:1, stop:0 #7060D4, stop:0.6 #5B4EAD, stop:1 #4C3DA4);
    border: 1px solid rgba(255, 255, 255, 70);
    border-radius: 36px;
}

#SplashTitle {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 800;
}

#SplashSubtitle {
    color: rgba(255, 255, 255, 200);
    font-size: 14px;
}
