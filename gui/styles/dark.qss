/* ===================================================================
   Cartify - Dark theme
   Generated from one token-driven template so both themes share the
   exact same structure. Colours are tuned per theme.
   =================================================================== */

/* ---------------- Base ---------------- */

QWidget {
    color: #F3F2FF;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #0B0B1C;
}

QLabel {
    background: transparent;
}

QStackedWidget {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QToolTip {
    background-color: #2A2B66;
    color: #FFFFFF;
    border: 1px solid #4B47A6;
    padding: 6px 10px;
    border-radius: 8px;
}

/* ---------------- Canvas + Shell ---------------- */

#Canvas {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #080817, stop:1 #1A1840);
}

#Shell {
    background-color: #0F0F26;
    border: 1px solid #26285A;
    border-radius: 32px;
}

/* ---------------- Sidebar (floating violet pill) ---------------- */

#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.7, y2:1, stop:0 #4A3BB8, stop:1 #221A64);
    border: 1px solid #5F52D0;
    border-radius: 30px;
}

#SidebarScroll {
    background: transparent;
    border: none;
}

#SidebarNav {
    background: transparent;
}

#SidebarTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 800;
}

#SidebarCaption {
    color: rgba(255, 255, 255, 165);
    font-size: 11px;
}

#SidebarDivider {
    background-color: rgba(255, 255, 255, 38);
    max-height: 1px;
    border: none;
}

QPushButton#NavButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 195);
    text-align: left;
    padding-left: 16px;
    border: 1px solid transparent;
    border-radius: 17px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background-color: rgba(255, 255, 255, 32);
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: rgba(255, 255, 255, 58);
    border-color: rgba(255, 255, 255, 80);
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#NavButton:pressed {
    background-color: rgba(255, 255, 255, 76);
}

QPushButton#NavButton[collapsed="true"] {
    padding-left: 0px;
    text-align: center;
}

/* ---------------- Header ---------------- */

#Navbar {
    background: transparent;
}

#NavbarCrumb {
    color: #9C9EC9;
    font-size: 14px;
    font-weight: 600;
}

#NavbarTitle {
    color: #F3F2FF;
    font-size: 15px;
    font-weight: 800;
}

#NavbarSubtitle {
    color: #9C9EC9;
    font-size: 13px;
}

#NavbarUserChip {
    background-color: #16173A;
    border: 1px solid #262853;
    border-radius: 25px;
}

#NavbarAdmin {
    color: #F3F2FF;
    font-size: 13px;
    font-weight: 700;
}

#NavbarRole {
    color: #9C9EC9;
    font-size: 11px;
}

#AdminAvatar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6A58E0, stop:1 #35298F);
    color: #FFFFFF;
    border-radius: 18px;
    font-weight: 800;
    font-size: 14px;
}

QToolButton#ThemeToggle {
    background-color: #16173A;
    border: 1px solid #262853;
    border-radius: 22px;
    padding: 0px;
}

QToolButton#ThemeToggle:hover {
    background-color: #25225A;
    border-color: #3E3888;
}

/* ---------------- Cards ---------------- */

#Card, #ChartCard, #StatCard, #FilterBar {
    background-color: #16173A;
    border: 1px solid #262853;
    border-radius: 24px;
}

#FilterBar {
    border-radius: 22px;
}

#StatCard[clickable="true"]:hover {
    border-color: #4B47A6;
    background-color: #1A1B44;
}

#HeroCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6A58E0, stop:0.55 #5648B7, stop:1 #35298F);
    border: 1px solid rgba(255, 255, 255, 34);
    border-radius: 30px;
}

#AccentCardViolet {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #705DED, stop:1 #35298F);
    border: 1px solid rgba(255, 255, 255, 34);
    border-radius: 28px;
}

#AccentCardPink {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F27BB0, stop:1 #B63F86);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 28px;
}

#AccentCardViolet[clickable="true"]:hover, #AccentCardPink[clickable="true"]:hover {
    border-color: rgba(255, 255, 255, 150);
}

#HeroTitle {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 700;
}

#HeroSub {
    color: rgba(255, 255, 255, 175);
    font-size: 12px;
}

#HeroGlass {
    background-color: rgba(255, 255, 255, 30);
    border: 1px solid rgba(255, 255, 255, 46);
    border-radius: 22px;
}

#HeroGlassStrong {
    background-color: rgba(255, 255, 255, 56);
    border: 1px solid rgba(255, 255, 255, 84);
    border-radius: 22px;
}

#HeroKpiValue {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 800;
}

#HeroKpiLabel {
    color: rgba(255, 255, 255, 185);
    font-size: 11px;
    font-weight: 600;
}

#AccentTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

#AccentSub {
    color: rgba(255, 255, 255, 195);
    font-size: 12px;
}

#AccentValue {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 800;
}

QPushButton#GlassButton {
    background-color: rgba(255, 255, 255, 52);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 84);
    border-radius: 17px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0px;
}

QPushButton#GlassButton:hover {
    background-color: rgba(255, 255, 255, 82);
}

#StatValue {
    color: #F3F2FF;
    font-size: 29px;
    font-weight: 800;
}

#StatTitle {
    color: #9C9EC9;
    font-size: 13px;
    font-weight: 600;
}

#StatCaption {
    color: #9C9EC9;
    font-size: 11px;
}

#StatShare {
    color: #35D08A;
    font-size: 11px;
    font-weight: 700;
}

#StatLink {
    color: #CBC3FF;
    background-color: #25225A;
    border: 1px solid #3E3888;
    border-radius: 12px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 700;
}

#TileValue {
    color: #F3F2FF;
    font-size: 25px;
    font-weight: 800;
}

#ChartTitle {
    color: #F3F2FF;
    font-size: 16px;
    font-weight: 800;
}

#ChartSub {
    color: #9C9EC9;
    font-size: 12px;
}

#PanelLabel {
    color: #9C9EC9;
    font-size: 12px;
    font-weight: 600;
}

#PanelValue {
    color: #F3F2FF;
    font-size: 13px;
    font-weight: 800;
}

#MetricTile {
    background-color: #1B1C42;
    border: 1px solid #262853;
    border-radius: 18px;
}

#ReportKpiCard {
    background-color: #151524;
    border: 1px solid #303044;
    border-radius: 14px;
}

#ReportKpiLabel {
    color: #A5ADBD;
    font-size: 11px;
    font-weight: 700;
}

#ReportKpiValue {
    color: #C4B5FD;
    font-size: 23px;
    font-weight: 800;
}

#DetailText {
    color: #F3F2FF;
    background-color: transparent;
}

#DetailSection {
    color: #F3F2FF;
    font-size: 15px;
    font-weight: 800;
}

#DetailValue {
    color: #F3F2FF;
    font-size: 14px;
    font-weight: 700;
}

#SettingsDivider {
    background-color: #212349;
    border: none;
}

#SettingsRow {
    background-color: transparent;
}

#SettingsItemTitle {
    color: #F3F2FF;
    font-size: 14px;
    font-weight: 700;
}

#SettingsItemDescription {
    color: #9C9EC9;
    font-size: 12px;
}

/* ---------------- Pills / badges ---------------- */

QLabel#Pill, QLabel#SettingsValuePill {
    background-color: #25225A;
    color: #CBC3FF;
    border: 1px solid #3E3888;
    border-radius: 13px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#Pill[tone="pink"] {
    background-color: #3B1D45;
    color: #FF9CC6;
    border-color: #6A2E66;
}

QLabel#Pill[tone="green"] {
    background-color: #123A33;
    color: #5EE0A5;
    border-color: #1F6B54;
}

QLabel#Pill[tone="amber"] {
    background-color: #3F3114;
    color: #F7C860;
    border-color: #7A5A1D;
}

/* ---------------- Buttons ---------------- */

QPushButton#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6A58E0, stop:1 #35298F);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 36);
    border-radius: 16px;
    padding: 10px 22px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7460F6, stop:1 #3C2EA3);
}

QPushButton#PrimaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5F4FC9, stop:1 #2E247D);
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#PrimaryButton:disabled {
    background: #262853;
    color: #9C9EC9;
    border-color: #262853;
}

QPushButton#SecondaryButton {
    background-color: #16173A;
    color: #F3F2FF;
    border: 1px solid #2C2E5C;
    border-radius: 16px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#SecondaryButton:hover {
    background-color: #25225A;
    border-color: #3E3888;
    color: #CBC3FF;
}

QPushButton#SecondaryButton:pressed {
    background-color: #3E3888;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#SecondaryButton:disabled {
    background-color: #1B1C42;
    color: #9C9EC9;
    border-color: #212349;
}

QPushButton#DangerButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EE4B5A, stop:1 #B93A46);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 50);
    border-radius: 16px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#DangerButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF5161, stop:1 #CB3F4D);
}

QPushButton#DangerButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D64351, stop:1 #9D313B);
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#SendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6A58E0, stop:1 #35298F);
    border: 1px solid rgba(255, 255, 255, 36);
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
}

QPushButton#SendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #725FF1, stop:1 #3B2DA0);
}

QPushButton#SendButton:disabled {
    background: #262853;
    border-color: #262853;
}

QToolButton#SortButton, QToolButton#IconButton {
    background-color: #16173A;
    border: 1px solid #2C2E5C;
    border-radius: 16px;
    padding: 7px;
}

QToolButton#SortButton:hover, QToolButton#IconButton:hover {
    background-color: #25225A;
    border-color: #3E3888;
}

QToolButton#SortButton:pressed, QToolButton#IconButton:pressed {
    background-color: #3E3888;
}

QToolButton#SortButton::menu-indicator {
    image: none;
    width: 0px;
}

QMenu {
    background-color: #16173A;
    border: 1px solid #4B47A6;
    border-radius: 14px;
    padding: 7px;
}

QMenu::item {
    padding: 9px 30px 9px 14px;
    border-radius: 9px;
    color: #F3F2FF;
}

QMenu::item:selected {
    background-color: #25225A;
    color: #CBC3FF;
}

QMenu::separator {
    height: 1px;
    background: #212349;
    margin: 6px 8px;
}

/* ---------------- Inputs ---------------- */

QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: #0E0F27;
    border: 1px solid #2C2E5C;
    border-radius: 15px;
    padding: 9px 14px;
    color: #F3F2FF;
    selection-background-color: #9C8CFF;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover, QTextEdit:hover {
    border-color: #4A47A0;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border-color: #9C8CFF;
    background-color: #13142F;
}

QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled {
    color: #9C9EC9;
    background-color: #1B1C42;
    border-color: #212349;
}

QLineEdit#SearchBar {
    border-radius: 22px;
    padding: 9px 18px;
}

QComboBox {
    padding: 9px 38px 9px 14px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 34px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(@ASSETS@/chevron_down_dark.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #16173A;
    color: #F3F2FF;
    border: 1px solid #4B47A6;
    border-radius: 12px;
    padding: 6px;
    outline: 0;
    selection-background-color: #25225A;
    selection-color: #CBC3FF;
}

QDateEdit, QDoubleSpinBox, QSpinBox {
    padding: 7px 40px 7px 14px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 36px;
    border: none;
    background: transparent;
}

QDateEdit::down-arrow {
    image: url(@ASSETS@/calendar_dark.svg);
    width: 18px;
    height: 18px;
}

QDoubleSpinBox::up-button, QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    background: transparent;
    margin: 4px 6px 0px 0px;
}

QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    border: none;
    background: transparent;
    margin: 0px 6px 4px 0px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #25225A;
    border-radius: 8px;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {
    image: url(@ASSETS@/chevron_up_dark.svg);
    width: 10px;
    height: 10px;
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {
    image: url(@ASSETS@/chevron_down_dark.svg);
    width: 10px;
    height: 10px;
}

/* ---------------- Calendar popup ---------------- */

QCalendarWidget {
    background-color: #16173A;
    border: 1px solid #4B47A6;
    border-radius: 14px;
}

QCalendarWidget QWidget {
    background-color: #16173A;
    color: #F3F2FF;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #25225A;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    padding: 4px;
}

QCalendarWidget QToolButton {
    color: #CBC3FF;
    background-color: transparent;
    border: none;
    border-radius: 9px;
    padding: 6px 10px;
    font-weight: 700;
}

QCalendarWidget QToolButton:hover {
    background-color: #3E3888;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(@ASSETS@/chevron_left_dark.svg);
    icon-size: 16px;
    min-width: 28px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(@ASSETS@/chevron_right_dark.svg);
    icon-size: 16px;
    min-width: 28px;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QCalendarWidget QSpinBox {
    color: #F3F2FF;
    background-color: #16173A;
    border: 1px solid #3E3888;
    border-radius: 9px;
    min-width: 92px;
    padding: 2px 28px 2px 8px;
    font-weight: 700;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #16173A;
    color: #F3F2FF;
    selection-background-color: #9C8CFF;
    selection-color: #FFFFFF;
    outline: 0;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #9C9EC9;
}

QCalendarWidget QTableView QHeaderView::section,
QCalendarWidget QHeaderView::section {
    background-color: #16173A;
    color: #CBC3FF;
    border: none;
    padding: 6px;
    font-weight: 700;
}

#SearchBarContainer {
    background-color: transparent;
}

/* ---------------- Progress ---------------- */

QProgressBar {
    background-color: #262853;
    border: none;
    border-radius: 6px;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6A58E0, stop:1 #35298F);
    border-radius: 6px;
}

QProgressBar[tone="green"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #35D08A, stop:1 #14805A);
}

QProgressBar[tone="pink"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #F27BB0, stop:1 #B63F86);
}

QProgressBar[thin="true"] {
    min-height: 7px;
    max-height: 7px;
    border-radius: 4px;
}

QProgressBar[thin="true"]::chunk {
    border-radius: 4px;
}

/* ---------------- Tables ---------------- */

QTableWidget {
    background: transparent;
    border: none;
    outline: 0;
    gridline-color: transparent;
    selection-background-color: transparent;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: transparent;
    color: #9C9EC9;
    padding: 12px 14px;
    border: none;
    border-bottom: 1px solid #212349;
    font-weight: 700;
    font-size: 12px;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QTableWidget::item {
    padding: 0px 14px;
    border-bottom: 1px solid #212349;
    color: #F3F2FF;
}

QTableWidget::item:hover {
    background-color: #1C1E45;
}

QTableWidget::item:selected {
    background-color: #2A2570;
    color: #EDEAFF;
}

#EmptyState {
    background: transparent;
}

#EmptyTitle {
    color: #F3F2FF;
    font-size: 16px;
    font-weight: 800;
}

#EmptyHint {
    color: #9C9EC9;
    font-size: 13px;
}

/* ---------------- Scrollbars ---------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: #3A3B78;
    border-radius: 3px;
    min-height: 34px;
}

QScrollBar::handle:vertical:hover {
    background: #9C8CFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #3A3B78;
    border-radius: 3px;
    min-width: 34px;
}

QScrollBar::handle:horizontal:hover {
    background: #9C8CFF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---------------- Typography ---------------- */

QLabel#PageTitle {
    color: #F3F2FF;
    font-size: 26px;
    font-weight: 800;
}

QLabel#PageSubtitle {
    color: #9C9EC9;
    font-size: 14px;
}

QLabel#DialogTitle {
    color: #F3F2FF;
    font-size: 21px;
    font-weight: 800;
}

QLabel#DialogSubtitle {
    color: #9C9EC9;
    font-size: 13px;
}

QLabel#FilterLabel {
    color: #9C9EC9;
    font-size: 12px;
    font-weight: 700;
}

QDialog QLabel {
    color: #9C9EC9;
    font-weight: 600;
}

QTextEdit {
    line-height: 145%;
}

/* ---------------- Dialogs / message boxes ---------------- */

QMessageBox {
    background-color: #0B0B1C;
}

QMessageBox QLabel {
    color: #F3F2FF;
    font-size: 14px;
    font-weight: 500;
}

QMessageBox QPushButton {
    background-color: #16173A;
    color: #F3F2FF;
    border: 1px solid #2C2E5C;
    border-radius: 14px;
    padding: 8px 22px;
    min-width: 72px;
    font-weight: 700;
}

QMessageBox QPushButton:hover {
    background-color: #25225A;
    border-color: #3E3888;
    color: #CBC3FF;
}

QMessageBox QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6A58E0, stop:1 #35298F);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 36);
}

QRadioButton {
    background-color: transparent;
    color: #F3F2FF;
    spacing: 10px;
    font-weight: 600;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #9C8CFF;
    border-color: #25225A;
}

QRadioButton::indicator:unchecked {
    background-color: #0E0F27;
    border-color: #4A47A0;
}

QCheckBox#ToggleSwitch {
    background-color: transparent;
    spacing: 0;
}

/* ---------------- AI assistant ---------------- */

#AIUserBubble {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6A58E0, stop:1 #35298F);
    border: 1px solid rgba(255, 255, 255, 36);
    border-radius: 22px;
}

#AIAssistantBubble {
    background-color: #1B1C42;
    border: 1px solid #262853;
    border-radius: 22px;
}

#AIMessageRole {
    color: #CBC3FF;
    font-size: 12px;
    font-weight: 800;
}

#AIMessageRoleUser {
    color: rgba(255, 255, 255, 190);
    font-size: 12px;
    font-weight: 800;
}

#AIMessageText {
    color: #F3F2FF;
    font-size: 14px;
}

#AIMessageTextUser {
    color: #FFFFFF;
    font-size: 14px;
}

#AITyping {
    color: #CBC3FF;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
}

#AISectionLabel {
    color: #9C9EC9;
    font-size: 12px;
    font-weight: 800;
    margin-top: 4px;
}

#AIProductCard {
    background-color: #16173A;
    border: 1px solid #262853;
    border-radius: 18px;
}

#AIProductTitle {
    color: #F3F2FF;
    font-size: 14px;
    font-weight: 800;
}

#AIProductPrice {
    color: #CBC3FF;
    font-size: 16px;
    font-weight: 800;
}

#AIProductMeta {
    color: #9C9EC9;
    font-size: 12px;
}

/* ---------------- Login / splash ---------------- */

#LoginRoot, #SplashRoot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #080817, stop:1 #1A1840);
}

#LoginShell {
    background-color: #16173A;
    border: 1px solid #262853;
    border-radius: 32px;
}

#LoginHero {
    background: qlineargradient(x1:0, y1:0, x2:0.8, y2:1, stop:0 #4A3BB8, stop:0.6 #3C3096, stop:1 #221A64);
    border: 1px solid rgba(255, 255, 255, 34);
    border-radius: 26px;
}

#LoginHeroTitle {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 800;
}

#LoginHeroText {
    color: rgba(255, 255, 255, 195);
    font-size: 14px;
}

#LoginFeatureTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
}

#LoginFeatureText {
    color: rgba(255, 255, 255, 175);
    font-size: 11px;
}

#LoginTitle {
    color: #F3F2FF;
    font-size: 28px;
    font-weight: 800;
}

#LoginError {
    color: #FF6B72;
    background-color: #401B26;
    border: 1px solid #7A2C3C;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

#SplashCard {
    background: qlineargradient(x1:0, y1:0, x2:0.8, y2:1, stop:0 #4A3BB8, stop:0.6 #3C3096, stop:1 #221A64);
    border: 1px solid rgba(255, 255, 255, 34);
    border-radius: 36px;
}

#SplashTitle {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 800;
}

#SplashSubtitle {
    color: rgba(255, 255, 255, 200);
    font-size: 14px;
}

/* ---------------- Dark-only refinements ---------------- */

/* luminous edge on raised surfaces */
#Card:hover, #ChartCard:hover {
    border-color: #4B47A6;
}

QTableWidget::item:selected {
    border-bottom: 1px solid #3E3888;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #9C8CFF;
}

QPushButton#SecondaryButton {
    background-color: #1B1C42;
}

QToolButton#SortButton, QToolButton#IconButton, QToolButton#ThemeToggle {
    background-color: #1B1C42;
}
